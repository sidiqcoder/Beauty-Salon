generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Booking {
  id                   String   @id @default(uuid())
  code                 String   @unique
  branchId             String
  branchName           String
  staffId              String?
  staffName            String?
  customerName         String
  customerPhone        String
  customerEmail        String?
  date                 String
  timeSlot             String
  servicesJson         String   // JSON stringified selected services
  totalAmount          Float
  totalDurationMinutes Int
  paymentMethod        String
  paymentStatus        String
  status               String   @default("PENDING")
  notes                String?
  createdAt            DateTime @default(now())
  updatedAt            DateTime @updatedAt

  @@index([branchId])
  @@index([date])
  @@index([status])
}

